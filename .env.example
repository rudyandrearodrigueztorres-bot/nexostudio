# =========================================================================
# NEXO STUDIO — CONFIGURACIÓN DE VARIABLES DE ENTORNO PARA CONTACTO (SMTP)
# =========================================================================
# Copia este archivo a un nuevo archivo llamado .env en este mismo directorio:
#   cp .env.example .env
#
# IMPORTANTE:
# 1. NUNCA subas el archivo .env a Git (ya está incluido en .gitignore).
# 2. Para Gmail, la contraseña NO es tu contraseña normal de Google:
#    debes generar una "Contraseña de aplicación" de 16 caracteres en:
#    https://myaccount.google.com/apppasswords
# =========================================================================

# Usuario SMTP de Gmail (el correo que enviará los mensajes)
SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación de 16 caracteres de Google (ej: abcd efgh ijkl mnop)
SMTP_PASS=tu_contrasena_de_aplicacion

# Destinatario para los mensajes dirigidos a Andrea Rodríguez
CONTACT_TO_ANDREA=rudyandrearodrigueztorres@gmail.com

# Destinatario para los mensajes dirigidos a Miguel Gómez
CONTACT_TO_MIGUEL=miguelangel160397@gmail.com

# Puerto opcional para el servidor local (por defecto 3000)
PORT=3000
